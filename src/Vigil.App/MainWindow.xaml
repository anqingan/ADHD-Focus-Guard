<Window x:Class="Vigil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADHD Focus Guard" Height="700" Width="920" MinHeight="620" MinWidth="780"
        Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Vigil" FontSize="32" FontWeight="Bold" Foreground="#FF252525" />
                <TextBlock Text="让目标约束屏幕，而不是让意志力独自硬撑。" Foreground="#FF777777" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#11000000" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="Ctrl + Alt + Shift + Space" Foreground="#FF666666" FontSize="12" />
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="专注">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,20,8,8">
                        <Border x:Name="StartCard" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24">
                            <StackPanel>
                                <TextBlock Text="这一轮要完成什么？" FontSize="18" FontWeight="SemiBold" />
                                <TextBox x:Name="GoalInput" Margin="0,12,0,14" FontSize="18" MaxLength="200"
                                         ToolTip="例如：完成项目周报初稿" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="时长" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox x:Name="DurationInput" Width="120" IsEditable="True" SelectedIndex="1">
                                        <ComboBoxItem Content="15" />
                                        <ComboBoxItem Content="25" />
                                        <ComboBoxItem Content="45" />
                                        <ComboBoxItem Content="60" />
                                    </ComboBox>
                                    <TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <Button x:Name="StartButton" Content="开始专注" Click="Start_Click"
                                            Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold"
                                            Margin="24,0,0,0" MinWidth="140" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RunningCard" Visibility="Collapsed" Background="{StaticResource CardBrush}"
                                CornerRadius="18" Padding="24" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="RunningGoalText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CurrentStateText" Margin="0,8,0,0" Foreground="#FFE56A3A" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock x:Name="RemainingText" Grid.Column="1" FontSize="42" FontWeight="Bold" FontFamily="Consolas" />
                                </Grid>
                                <Border x:Name="ObservationPanel" Background="#FFF4F4F4" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="最近观察" Foreground="#FF888888" FontSize="12" />
                                        <TextBlock x:Name="ActivityText" Text="等待第一次判断…" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ConnectionText" Foreground="#FFC56A18" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="隐藏到托盘" Click="Hide_Click" />
                                    <Button x:Name="StopButton" Content="结束本轮" Click="Stop_Click" Foreground="#FFB52922" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CompletedCard" Visibility="Collapsed" Background="{StaticResource CardBrush}"
                                CornerRadius="18" Padding="24" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="本轮完成" FontSize="22" FontWeight="Bold" Foreground="#FF277A43" />
                                <TextBlock x:Name="RatioText" Margin="0,12,0,0" Foreground="#FF666666" TextWrapping="Wrap" />
                                <TextBlock x:Name="SummaryText" Margin="0,14,0,0" FontSize="15" LineHeight="24" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="再来一轮" Click="Again_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="目标">
                <Grid Margin="8,20,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18">
                        <StackPanel>
                            <TextBlock Text="新增目标" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="时间尺度" Margin="0,14,0,4" />
                            <ComboBox x:Name="GoalHorizonInput" SelectedIndex="3">
                                <ComboBoxItem Content="长期方向（半年到一年）" Tag="Direction" />
                                <ComboBoxItem Content="阶段目标（1–3 个月）" Tag="Stage" />
                                <ComboBoxItem Content="本周目标" Tag="Week" />
                                <ComboBoxItem Content="今日目标" Tag="Today" />
                            </ComboBox>
                            <TextBlock Text="标题" Margin="0,12,0,4"/><TextBox x:Name="NewGoalTitle" MaxLength="500" />
                            <TextBlock Text="期望结果" Margin="0,12,0,4"/><TextBox x:Name="NewGoalOutcome" Height="76" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="截止日期（可选，yyyy-MM-dd）" Margin="0,12,0,4"/><TextBox x:Name="NewGoalDue" />
                            <TextBlock Text="关联目标（可选）" Margin="0,12,0,4"/><ComboBox x:Name="GoalRelationInput" IsEditable="False" />
                            <Button Content="保存目标" Click="AddGoal_Click" Margin="0,16,0,0" Background="{StaticResource AccentBrush}" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="编辑所选" Click="EditGoal_Click" />
                                <Button Content="进行中" Tag="InProgress" Click="SetGoalStatus_Click" />
                                <Button Content="已完成" Tag="Completed" Click="SetGoalStatus_Click" />
                                <Button Content="暂停" Tag="Paused" Click="SetGoalStatus_Click" />
                                <Button Content="放弃" Tag="Abandoned" Click="SetGoalStatus_Click" />
                            </StackPanel>
                            <ListBox x:Name="GoalsList" BorderThickness="0" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="事务安排">
                <Grid Margin="8,20,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18">
                        <StackPanel>
                            <TextBlock Text="自由写下安排" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="可以混合写多件事；AI 整理后必须确认才会保存。" Foreground="#FF777777" Margin="0,4,0,10"/>
                            <TextBox x:Name="ActionInboxInput" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="交给 AI 整理" Click="OrganizeActions_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                                <Button x:Name="ConfirmDraftsButton" Content="确认全部候选事务" Click="ConfirmActionDrafts_Click" Visibility="Collapsed" />
                                <TextBlock x:Name="ActionStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FF777777" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="删除所选候选" Click="DeleteActionDraft_Click"/></StackPanel><TextBlock DockPanel.Dock="Top" Text="AI 候选预览（可直接编辑单元格）" FontWeight="Bold" Margin="0,0,0,8"/><DataGrid x:Name="ActionDraftsList" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="事务" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="结果" Binding="{Binding ExpectedOutcome}" Width="2*"/><DataGridTextColumn Header="截止" Binding="{Binding DueText}" Width="120"/><DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="65"/><DataGridTextColumn Header="分钟" Binding="{Binding EstimatedMinutes}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel></Border>
                        <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="标记完成" Click="CompleteAction_Click"/><Button Content="删除" Click="DeleteAction_Click"/></StackPanel><TextBlock DockPanel.Dock="Top" Text="已保存事务" FontWeight="Bold" Margin="0,0,0,8"/><ListBox x:Name="ActionsList" BorderThickness="0"/></DockPanel></Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="记忆">
                <Grid Margin="8,20,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18">
                        <StackPanel>
                            <TextBlock Text="写一条记忆" FontSize="20" FontWeight="Bold" />
                            <TextBox x:Name="MemoryInput" Height="76" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="MemoryTagsInput" Width="260" ToolTip="标签，用逗号分隔"/><Button Content="保存/更新记忆" Click="AddMemory_Click" Background="{StaticResource AccentBrush}" Foreground="White"/><Button Content="载入所选进行编辑" Click="EditMemory_Click"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="MemorySearchInput" Width="260" ToolTip="搜索正文或标签"/><Button Content="搜索" Click="SearchMemories_Click"/><Button Content="清除搜索" Click="ClearMemorySearch_Click"/></StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="14" Margin="0,14,0,0">
                        <DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="确认 AI 记忆" Click="ConfirmMemory_Click"/><Button Content="置顶/取消置顶" Click="PinMemory_Click"/><Button Content="归档" Click="ArchiveMemory_Click"/><Button Content="删除" Click="DeleteMemory_Click"/></StackPanel><ListBox x:Name="MemoriesList" BorderThickness="0"/></DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="活动与统计">
                <Grid Margin="8,20,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="16">
                        <StackPanel><TextBlock Text="ActivityWatch 自动记录" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="TrackerStatusText" Text="正在连接…" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="TodayTotalsText" Margin="0,8,0,0" FontWeight="SemiBold"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="学习与工作"/><ProgressBar x:Name="WorkProgress" Grid.Column="1" Height="12" Maximum="100"/><TextBlock Grid.Row="1" Text="娱乐"/><ProgressBar x:Name="EntertainmentProgress" Grid.Row="1" Grid.Column="1" Height="12" Maximum="100"/><TextBlock Grid.Row="2" Text="其它"/><ProgressBar x:Name="OtherProgress" Grid.Row="2" Grid.Column="1" Height="12" Maximum="100"/></Grid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="刷新今日统计" Click="RefreshActivity_Click"/><Button Content="删除今日活动记录" Click="DeleteTodayActivity_Click" Foreground="#FFB52922"/></StackPanel></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="14" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal"><TextBox x:Name="ManualActivityName" Width="240" ToolTip="线下活动名称"/><ComboBox x:Name="ManualActivityCategory" Width="140" SelectedIndex="0"><ComboBoxItem Content="学习与工作" Tag="WorkAndStudy"/><ComboBoxItem Content="娱乐" Tag="Entertainment"/><ComboBoxItem Content="其它" Tag="Other"/></ComboBox><TextBox x:Name="ManualActivityMinutes" Width="100" ToolTip="分钟"/><Button Content="补录到现在之前" Click="AddManualActivity_Click"/></StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="14" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="纠正规则范围" VerticalAlignment="Center"/><ComboBox x:Name="CorrectionScopeInput" Width="150" SelectedIndex="1"><ComboBoxItem Content="仅本次" Tag="Exact"/><ComboBoxItem Content="相似活动" Tag="Similar"/><ComboBoxItem Content="整个应用或网站" Tag="ApplicationOrDomain"/></ComboBox><CheckBox x:Name="CorrectHistoryCheck" Content="同时修改历史匹配记录" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="改为学习与工作" Tag="WorkAndStudy" Click="CorrectActivity_Click"/><Button Content="改为娱乐" Tag="Entertainment" Click="CorrectActivity_Click"/><Button Content="改为其它" Tag="Other" Click="CorrectActivity_Click"/></StackPanel></StackPanel><ListBox x:Name="ActivitiesList" BorderThickness="0"/></DockPanel></Border>
                </Grid>
            </TabItem>

            <TabItem Header="报告">
                <Grid Margin="8,20,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="生成/重新生成今日日报" Click="GenerateDailyReport_Click" Background="{StaticResource AccentBrush}" Foreground="White"/><TextBlock x:Name="ReportStatusText" Margin="0,8,0,8" TextWrapping="Wrap" Foreground="#FF777777"/></StackPanel><ListBox x:Name="ReportsList" SelectionChanged="ReportsList_SelectionChanged" BorderThickness="0"/></DockPanel></Border>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20"><ScrollViewer><StackPanel><TextBlock x:Name="ReportFactsText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><Separator Margin="0,14"/><TextBlock x:Name="ReportInferenceText" TextWrapping="Wrap" LineHeight="23"/><TextBlock x:Name="ReportSuggestionsText" TextWrapping="Wrap" LineHeight="23" Margin="0,14,0,0"/></StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>

            <TabItem Header="历史">
                <Grid Margin="8,20,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="12">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="清空全部" Click="DeleteAll_Click" Foreground="#FFB52922" />
                            <ListBox x:Name="HistoryList" SelectionChanged="HistoryList_SelectionChanged" BorderThickness="0" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="22">
                        <StackPanel>
                            <TextBlock x:Name="HistoryGoalText" Text="选择一条历史记录" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="HistoryMetaText" Margin="0,10,0,0" Foreground="#FF777777" TextWrapping="Wrap" />
                            <TextBlock x:Name="HistorySummaryText" Margin="0,18,0,0" FontSize="15" LineHeight="24" TextWrapping="Wrap" />
                            <Button x:Name="DeleteSelectedButton" Content="删除这条记录" Click="DeleteSelected_Click"
                                    Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Margin="8,20,8,8" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="26">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="云端视觉模型" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="使用 OpenAI-compatible Chat Completions。真实截图只在专注会话中发送，连接测试使用程序生成的图片。"
                                       Foreground="#FF777777" TextWrapping="Wrap" Margin="0,7,0,18" />
                            <TextBlock Text="Base URL（必须 HTTPS）" />
                            <TextBox x:Name="BaseUrlInput" Margin="0,6,0,12" />
                            <TextBlock Text="文本模型" />
                            <TextBox x:Name="TextModelInput" Margin="0,6,0,12" />
                            <TextBlock Text="视觉模型" />
                            <TextBox x:Name="ModelInput" Margin="0,6,0,12" />
                            <TextBlock Text="API Key（留空表示保留已保存密钥）" />
                            <PasswordBox x:Name="ApiKeyInput" Padding="8" Margin="0,6,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存" Click="SaveSettings_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                                <Button Content="保存并测试视觉能力" Click="TestSettings_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SettingsStatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
                            <Separator Margin="0,24,0,16" />
                            <TextBlock Text="隐私边界" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Vigil 不创建屏幕截图文件，也不保存逐帧活动。数据库敏感文本与 API Key 均由当前 Windows 用户的 DPAPI 加密。"
                                       Margin="0,8,0,0" Foreground="#FF666666" TextWrapping="Wrap" />
                            <Separator Margin="0,24,0,16" />
                            <TextBlock Text="备份与恢复" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="导出包包含 JSON、CSV 和 Markdown，不包含 API Key、截图或 ActivityWatch 原始事件。导出文件本身未加密，请妥善保存。" Margin="0,8,0,10" Foreground="#FF666666" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal"><Button Content="导出全部数据" Click="ExportData_Click"/><Button Content="从备份恢复" Click="ImportData_Click"/></StackPanel>
                            <Button Content="清空目标、事务、记忆、活动和报告" Click="ClearPersonalData_Click" Foreground="#FFB52922" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            <TextBlock x:Name="BackupStatusText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
