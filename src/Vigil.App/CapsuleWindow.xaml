<Window x:Class="Vigil.App.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="92"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Border Background="#EE171717" CornerRadius="24" Padding="22,14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StateDot" Width="13" Height="13" Fill="#FFE56A3A" Margin="0,0,14,0" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="15" />
                <TextBlock x:Name="MessageText" Foreground="#DDFFFFFF" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
