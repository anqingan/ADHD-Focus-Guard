<Window x:Class="Vigil.App.DailyPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今天最重要的结果" Width="560" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FFF5F4F1" Topmost="True">
    <Border Margin="22" Padding="22" Background="White" CornerRadius="18">
        <StackPanel>
            <TextBlock Text="今天最重要的结果是什么？" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="可以直接写下多件事。下一步会由 AI 拆解、关联已有目标并展示预览，确认后才保存。" Foreground="#FF6E6E6E" Margin="0,7,0,14" TextWrapping="Wrap"/>
            <Border Background="#FFF4F4F4" CornerRadius="8" Padding="9" Margin="0,0,0,10"><TextBlock x:Name="AiSuggestionText" Text="AI 建议暂不可用，你仍可以直接填写。" TextWrapping="Wrap" Foreground="#FF666666"/></Border>
            <TextBox x:Name="GoalText" Height="105" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" FontSize="16" Padding="10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="10 分钟后" Tag="10" Click="Snooze_Click"/>
                <Button Content="30 分钟后" Tag="30" Click="Snooze_Click"/>
                <Button Content="1 小时后" Tag="60" Click="Snooze_Click"/>
                <Button Content="AI 分析并预览" Click="Save_Click" Background="#FFE56A3A" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
