<Window x:Class="Vigil.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#B8000000"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Grid>
        <Border Width="700" MaxHeight="460" Background="#F21D1D1D" CornerRadius="30" Padding="46"
                HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#55FFFFFF" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="回来一下" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="GoalText" Foreground="#AAFFFFFF" FontSize="15" Margin="0,16,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="ReminderText" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="0,22"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="返回目标" Click="Return_Click" Background="#FFFF8A4C" FontWeight="Bold" MinWidth="140" />
                    <Button Content="AI 误判，本段不再提醒" Click="Mute_Click" Foreground="#FFDDDDDD" Background="#FF333333" MinWidth="210" />
                </StackPanel>
                <TextBlock Text="15 秒后自动关闭" Foreground="#77FFFFFF" FontSize="12" Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
